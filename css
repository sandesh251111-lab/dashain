
.kite-scene {
  min-height: 570px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 45px 20px;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% 15%, #d64c36 0%, transparent 48%),
    linear-gradient(180deg, #690909, #3a0009);
  border-radius: 24px;
}

.sun-glow {
  position: absolute;
  z-index: -1;
  top: 3%;
  left: 50%;
  width: 260px;
  height: 260px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: #ffbd59;
  opacity: .2;
  filter: blur(55px);
}

.distant-cloud {
  position: absolute;
  z-index: -1;
  width: 180px;
  height: 35px;
  border-radius: 50%;
  background: rgba(255, 218, 166, .12);
  filter: blur(10px);
}

.cloud-one {
  top: 23%;
  left: 5%;
}

.cloud-two {
  top: 34%;
  right: 3%;
  transform: scale(1.3);
}

.kite {
  width: clamp(145px, 32vw, 225px);
  animation: grandKiteFlight 6s ease-in-out infinite;
  filter: drop-shadow(0 12px 22px rgba(0, 0, 0, .3));
  transform-origin: 50% 40%;
}

.kite svg {
  display: block;
  width: 100%;
  height: auto;
}

.kite-message {
  z-index: 1;
  text-align: center;
  margin-top: 18px;
  max-width: 650px;
}

.small-label {
  color: #ffcf7a;
  font-size: .75rem;
  letter-spacing: 4px;
  text-transform: uppercase;
}

.kite-message p {
  margin: 18px 0;
  color: #fff2d1;
  font-family: Georgia, serif;
  font-size: clamp(1.15rem, 3.6vw, 1.8rem);
  line-height: 1.8;
  text-shadow: 0 3px 15px rgba(0, 0, 0, .35);
}

